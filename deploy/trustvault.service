[Unit]
Description=TrustVault (gunicorn)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/trustvault
EnvironmentFile=/etc/trustvault.env
ExecStart=/opt/trustvault/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 --access-logfile - wsgi:app
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trustvault

[Install]
WantedBy=multi-user.target
